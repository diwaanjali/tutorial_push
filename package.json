{
  "name": "campus-pulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Intelligent campus life organiser and AI event parser",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "dev": "vite",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.js --packages=external",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/api",
    "test:watch": "vitest tests/unit tests/api",
    "e2e": "playwright test",
    "size-check": "node scripts/size-check.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "chrono-node": "^2.7.7",
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.10",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.11",
    "vitest": "^4.1.12"
  }
}
